.DS_Store
.env
.env.*
!.env.example
build/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.idea/
*.log

# RAG VDB outputs (chroma sqlite + bm25 pickle + metadata) — large, regenerable.
play/*/vdb/
play/qa_assets/vdb/

# Evaluation run artifacts (per-run result/samples + cross-run index) — regenerable from `python -m evals score/run`.
play/evals/runs/

# agent_sft Phase 2 mined data — local smoke / scratch artifacts only; final 1k / v1.5 batches committed below.
play/agent_sft/data/triples/runs/
play/agent_sft/data/triples/*.jsonl
# Keep final Phase 2 (v1) deliverables: 250 envelopes per model + derived jsonl
!play/agent_sft/data/triples/*_1k.jsonl
# Keep v1.5 (qwen3.5:9b base, DECISIONS §10) train / val / merged triples
!play/agent_sft/data/triples/train_qwen3.jsonl
!play/agent_sft/data/triples/val_qwen3.jsonl
!play/agent_sft/data/triples/triples_qwen3.jsonl
# Keep v1.6 clean-data artifacts (DECISIONS §11)
!play/agent_sft/data/triples/train_qwen3_clean.jsonl
!play/agent_sft/data/triples/val_qwen3_clean.jsonl
!play/agent_sft/data/triples/triples_qwen3_clean.jsonl
!play/agent_sft/data/triples/*_clean_raw.jsonl

# agent_sft Phase 3 training artifacts policy (DECISIONS §5):
# - Smoke run (throwaway): ignored entirely.
# - Per-run `.data/` symlink dirs (data plumbing): ignored.
# - All adapter `.safetensors` ignored by default — except the Phase 4 entry adapter
#   at runs/sweeps/iters/200/ which is the recommended config from sweep (DECISIONS §5)
#   and unblocks Phase 4 fuse on a fresh checkout.
# - All analysis artifacts (`REPORT.md`, `results.json`, per-run `train.log` /
#   `train_metrics.json` / `eval_smoke.json`, `adapter_config.json`) committed for
#   cross-machine reproducibility + traceability (~100 KB total).
play/agent_sft/train/runs/smoke/
play/agent_sft/train/runs/sweeps/**/.data/
play/agent_sft/train/runs/sweeps/**/*.safetensors
!play/agent_sft/train/runs/sweeps/iters/200/adapters.safetensors
# Override the global `*.log` rule (top of this file) for sweep logs — small text artifacts,
# useful for post-mortem of train + eval timing / per-iter loss curve / divergence checks.
!play/agent_sft/train/runs/sweeps/sweep.log
!play/agent_sft/train/runs/sweeps/**/*.log

# agent_sft v1.5 (qwen3.5:9b base; DECISIONS §10) training artifacts:
# - smoke_qwen3/ (throwaway 10-iter probe): ignore entirely.
# - main_qwen3/.data/ (mlx_lm internal format cache): ignore.
# - main_qwen3/0000NNN_adapters.safetensors (intermediate checkpoints every 100 iter): ignore.
# - main_qwen3/adapters.safetensors (final adapter): committed — Phase 4 fuse entry point on fresh checkout.
# - main_qwen3/{adapter_config.json,train_metrics.json,eval_smoke.json,eval_smoke_samples.jsonl,train.log}: committed.
play/agent_sft/train/runs/smoke_qwen3/
play/agent_sft/train/runs/main_qwen3/.data/
play/agent_sft/train/runs/main_qwen3/0000*_adapters.safetensors
!play/agent_sft/train/runs/main_qwen3/adapters.safetensors
!play/agent_sft/train/runs/main_qwen3/train.log

# agent_sft v1.6 (bf16 clean retrain; DECISIONS §11) training artifacts:
# - ignore per-run `.data/` cache dirs and main intermediate checkpoints.
play/agent_sft/train/runs/smoke_qwen3_bf16/.data/
play/agent_sft/train/runs/probe_qwen3_bf16_nl4/.data/
play/agent_sft/train/runs/main_qwen3_bf16_clean/.data/
play/agent_sft/train/runs/main_qwen3_bf16_clean/0000*_adapters.safetensors
!play/agent_sft/train/runs/smoke_qwen3_bf16/train.log
!play/agent_sft/train/runs/probe_qwen3_bf16_nl4/train.log
!play/agent_sft/train/runs/main_qwen3_bf16_clean/train.log

# agent_sft Phase 4 deploy artifacts: ~18 GB intermediates (fused-mlx-fp16 + f16 gguf + q4 gguf)
# already covered by the top-level `build/` rule, listed explicitly for grep-ability.
play/agent_sft/deploy/build/
